3. backend/routes/users.js
const express = require("express");

const router = express.Router();

let users = [
    {
        id: 1,
        name: "Demo User",
        email: "demo@example.com"
    }
];

// Get all users
router.get("/", (req, res) => {
    res.json(users);
});

// Get user by ID
router.get("/:id", (req, res) => {
    const user = users.find(u => u.id === Number(req.params.id));

    if (!user) {
        return res.status(404).json({
            message: "User not found"
        });
    }

    res.json(user);
});

// Create user
router.post("/", (req, res) => {
    const { name, email } = req.body;

    if (!name || !email) {
        return res.status(400).json({
            message: "Name and email are required"
        });
    }

    const newUser = {
        id: users.length + 1,
        name,
        email
    };

    users.push(newUser);

    res.status(201).json(newUser);
});

module.exports = router;

4. backend/routes/skills.js
const express = require("express");

const router = express.Router();

let skills = [
    {
        id: 1,
        userId: 1,
        name: "JavaScript",
        level: "Intermediate",
        verified: true
    },
    {
        id: 2,
        userId: 1,
        name: "Python",
        level: "Beginner",
        verified: false
    }
];

// Get all skills
router.get("/", (req, res) => {
    res.json(skills);
});

// Get skills of a particular user
router.get("/user/:userId", (req, res) => {
    const userSkills = skills.filter(
        skill => skill.userId === Number(req.params.userId)
    );

    res.json(userSkills);
});

// Add a skill
router.post("/", (req, res) => {
    const { userId, name, level } = req.body;

    if (!userId || !name || !level) {
        return res.status(400).json({
            message: "userId, name and level are required"
        });
    }

    const newSkill = {
        id: skills.length + 1,
        userId: Number(userId),
        name,
        level,
        verified: false
    };

    skills.push(newSkill);

    res.status(201).json(newSkill);
});

// Verify a skill
router.patch("/:id/verify", (req, res) => {
    const skill = skills.find(
        skill => skill.id === Number(req.params.id)
    );

    if (!skill) {
        return res.status(404).json({
            message: "Skill not found"
        });
    }

    skill.verified = true;

    res.json(skill);
});

module.exports = router;

5. backend/routes/wallet.js
const express = require("express");

const router = express.Router();

let wallets = {
    1: {
        userId: 1,
        points: 100,
        achievements: [
            "JavaScript Beginner",
            "Skill Wallet Member"
        ]
    }
};

// Get wallet
router.get("/:userId", (req, res) => {
    const wallet = wallets[req.params.userId];

    if (!wallet) {
        return res.status(404).json({
            message: "Wallet not found"
        });
    }

    res.json(wallet);
});

// Add points
router.post("/:userId/points", (req, res) => {
    const userId = req.params.userId;
    const points = Number(req.body.points);

    if (!wallets[userId]) {
        wallets[userId] = {
            userId: Number(userId),
            points: 0,
            achievements: []
        };
    }

    if (!points || points < 0) {
        return res.status(400).json({
            message: "Valid points value is required"
        });
    }

    wallets[userId].points += points;

    res.json(wallets[userId]);
});

// Add achievement
router.post("/:userId/achievement", (req, res) => {
    const userId = req.params.userId;
    const { achievement } = req.body;

    if (!achievement) {
        return res.status(400).json({
            message: "Achievement is required"
        });
    }

    if (!wallets[userId]) {
        wallets[userId] = {
            userId: Number(userId),
            points: 0,
            achievements: []
        };
    }

    wallets[userId].achievements.push(achievement);

    res.json(wallets[userId]);
});

module.exports = router;

