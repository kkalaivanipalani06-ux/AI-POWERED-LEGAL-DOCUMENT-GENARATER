frontend/app.js
const API_URL = "http://localhost:5000/api";

const userId = 1;

async function loadUser() {
    const response = await fetch(`${API_URL}/users/${userId}`);
    const user = await response.json();

    document.getElementById("userName").textContent = user.name;
    document.getElementById("userEmail").textContent = user.email;
}

async function loadSkills() {
    const response = await fetch(`${API_URL}/skills/user/${userId}`);
    const skills = await response.json();

    const skillsContainer = document.getElementById("skills");

    skillsContainer.innerHTML = "";

    skills.forEach(skill => {
        const div = document.createElement("div");

        div.className = "skill";

        div.innerHTML = `
            <strong>${skill.name}</strong>
            <br>
            Level: ${skill.level}
            <br>
            <span class="${skill.verified ? "verified" : "not-verified"}">
                ${skill.verified ? "✓ Verified" : "Not Verified"}
            </span>
        `;

        skillsContainer.appendChild(div);
    });
}

async function loadWallet() {
    const response = await fetch(`${API_URL}/wallet/${userId}`);
    const wallet = await response.json();

    document.getElementById("points").textContent = wallet.points;

    const achievements =
        document.getElementById("achievements");

    achievements.innerHTML = "";

    wallet.achievements.forEach(item => {
        const li = document.createElement("li");

        li.textContent = item;

        achievements.appendChild(li);
    });
}

async function loadDashboard() {
    try {
        await loadUser();
        await loadSkills();
        await loadWallet();
    } catch (error) {
        console.error("Error loading dashboard:", error);
    }
}

loadDashboard();

