from fastapi import APIRouter, HTTPException

from app.models import wallets, users
from app.schemas import (
    WalletResponse,
    PointsRequest,
    AchievementRequest
)

router = APIRouter()


def get_or_create_wallet(user_id: int):

    if user_id not in wallets:
        wallets[user_id] = {
            "user_id": user_id,
            "points": 0,
            "achievements": []
        }

    return wallets[user_id]


@router.get(
    "/{user_id}",
    response_model=WalletResponse
)
def get_wallet(user_id: int):

    user_exists = any(
        user["id"] == user_id
        for user in users
    )

    if not user_exists:
        raise HTTPException(
            status_code=404,
            detail="User not found"
        )

    return get_or_create_wallet(user_id)


@router.post(
    "/{user_id}/points",
    response_model=WalletResponse
)
def add_points(
    user_id: int,
    request: PointsRequest
):

    user_exists = any(
        user["id"] == user_id
        for user in users
    )

    if not user_exists:
        raise HTTPException(
            status_code=404,
            detail="User not found"
        )

    wallet = get_or_create_wallet(user_id)

    wallet["points"] += request.points

    return wallet


@router.post(
    "/{user_id}/achievement",
    response_model=WalletResponse
)
def add_achievement(
    user_id: int,
    request: AchievementRequest
):

    user_exists = any(
        user["id"] == user_id
        for user in users
    )

    if not user_exists:
        raise HTTPException(
            status_code=404,
            detail="User not found"
        )

    wallet = get_or_create_wallet(user_id)

    wallet["achievements"].append(
        request.achievement
    )

    return wallet

