from fastapi import APIRouter, HTTPException

from app.models import users
from app.schemas import UserCreate, UserResponse

router = APIRouter()


@router.get("/", response_model=list[UserResponse])
def get_users():
    return users


@router.get("/{user_id}", response_model=UserResponse)
def get_user(user_id: int):
    user = next(
        (user for user in users if user["id"] == user_id),
        None
    )

    if user is None:
        raise HTTPException(
            status_code=404,
            detail="User not found"
        )

    return user


@router.post(
    "/",
    response_model=UserResponse,
    status_code=201
)
def create_user(user_data: UserCreate):

    existing_user = next(
        (
            user
            for user in users
            if user["email"] == user_data.email
        ),
        None
    )

    if existing_user:
        raise HTTPException(
            status_code=409,
            detail="Email already registered"
        )

    new_user = {
        "id": len(users) + 1,
        "name": user_data.name,
        "email": user_data.email
    }

    users.append(new_user)

    return new_user

backend/app/routers/skills.py
from fastapi import APIRouter, HTTPException

from app.models import skills, users
from app.schemas import SkillCreate, SkillResponse

router = APIRouter()


@router.get("/", response_model=list[SkillResponse])
def get_all_skills():
    return skills


@router.get(
    "/user/{user_id}",
    response_model=list[SkillResponse]
)
def get_user_skills(user_id: int):

    user_exists = any(
        user["id"] == user_id
        for user in users
    )

    if not user_exists:
        raise HTTPException(
            status_code=404,
            detail="User not found"
        )

    return [
        skill
        for skill in skills
        if skill["user_id"] == user_id
    ]


@router.post(
    "/",
    response_model=SkillResponse,
    status_code=201
)
def create_skill(skill_data: SkillCreate):

    user_exists = any(
        user["id"] == skill_data.user_id
        for user in users
    )

    if not user_exists:
        raise HTTPException(
            status_code=404,
            detail="User not found"
        )

    new_skill = {
        "id": len(skills) + 1,
        "user_id": skill_data.user_id,
        "name": skill_data.name,
        "level": skill_data.level,
        "verified": False
    }

    skills.append(new_skill)

    return new_skill


@router.patch(
    "/{skill_id}/verify",
    response_model=SkillResponse
)
def verify_skill(skill_id: int):

    skill = next(
        (
            skill
            for skill in skills
            if skill["id"] == skill_id
        ),
        None
    )

    if skill is None:
        raise HTTPException(
            status_code=404,
            detail="Skill not found"
        )

    skill["verified"] = True

    return skill

